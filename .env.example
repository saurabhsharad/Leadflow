# LeadFlow environment configuration — EXAMPLE ONLY
#
# Copy to .env for local development and adjust as needed.
# All values below are local-development placeholders, not real credentials.
# Never commit a real .env file.

# Application timezone (IANA name), used for dates and follow-up scheduling
APP_TIMEZONE=Asia/Kolkata

# PostgreSQL server created by Docker Compose (placeholder local-dev credentials).
# If you change these, update DATABASE_URL below to match.
POSTGRES_USER=leadflow
POSTGRES_PASSWORD=local_dev_password_change_me
POSTGRES_DB=leadflow

# PostgreSQL connection URL (SQLAlchemy format) used by a backend running
# directly on the host. Port 5433 is where Docker Compose publishes PostgreSQL.
# Inside Docker Compose the backend instead connects to db:5432; that URL is
# built from the POSTGRES_* values in docker-compose.yml.
DATABASE_URL=postgresql+psycopg://leadflow:local_dev_password_change_me@localhost:5433/leadflow

# Dedicated database for backend PostgreSQL tests (created by docker/postgres/).
# Tests drop and recreate its tables, so its name must end in "_test".
TEST_DATABASE_URL=postgresql+psycopg://leadflow:local_dev_password_change_me@localhost:5433/leadflow_test

# Comma-separated list of origins allowed to call the backend API (no "*")
CORS_ORIGINS=http://localhost:3000

# Base URL the browser uses to reach the backend API. The same value works for
# host development and Docker Compose, because the browser runs on the host.
NEXT_PUBLIC_API_URL=http://localhost:8000
