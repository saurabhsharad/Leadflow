# LeadFlow environment configuration — EXAMPLE ONLY
#
# Copy to .env for local development and adjust as needed.
# All values below are local-development placeholders, not real credentials.
# Never commit a real .env file.

# Application timezone (IANA name), used for dates and follow-up scheduling
APP_TIMEZONE=Asia/Kolkata

# PostgreSQL connection URL (SQLAlchemy format)
# Placeholder local-development credentials — replace for your environment.
DATABASE_URL=postgresql+psycopg://leadflow:local_dev_password_change_me@localhost:5432/leadflow

# Comma-separated list of origins allowed to call the backend API
CORS_ORIGINS=http://localhost:3000

# Base URL the frontend uses to reach the backend API
NEXT_PUBLIC_API_URL=http://localhost:8000
